digraph "symstack"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="symstack",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="zásobník, ukazatel na vrchol zásobníku"];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" top" ];
  Node2 [label="stack_node",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structstack__node.html",tooltip="uzel v zásobníku"];
  Node3 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" symtable" ];
  Node3 [label="tree_node",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structtree__node.html",tooltip="Uzel stromu."];
  Node3 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" left\nright" ];
  Node4 -> Node3 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" data" ];
  Node4 [label="symbol_data",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$structsymbol__data.html",tooltip="Data uloženého symbolu."];
  Node2 -> Node2 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" next" ];
}
